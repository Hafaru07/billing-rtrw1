---
import '../styles/global.css';
import { company } from '../data/site';
import FloatingContact from '../components/FloatingContact.astro';
const { title, description = 'Paket internet broadband Elround Network untuk kebutuhan rumah. Lihat harga dan cek jangkauan layanan.' } = Astro.props;
const pageTitle = title ? `${title} | ${company.name}` : `${company.name} | Internet rumah tanpa FUP`;
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#071c49" />
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://portal.elroundnet.my.id/og-image.jpg" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Lewati ke konten</a>
    <slot />
    <FloatingContact />
  </body>
</html>
