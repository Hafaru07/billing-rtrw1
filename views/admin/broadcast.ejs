<!DOCTYPE html>
<html lang="<%= lang || 'id' %>">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
  <title><%= t('admin.broadcast.title', 'Broadcast WhatsApp') %> | <%= company %></title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/css/admin.css">
  <style>
    .wa-tabs { display: flex; gap: 8px; margin-bottom: 14px; border-bottom: 1px solid var(--border); padding-bottom: 10px; overflow-x: auto; -webkit-overflow-scrolling: touch; white-space: nowrap; }
    .wa-tab { padding: 8px 14px; border-radius: 8px; cursor: pointer; color: var(--muted); transition: all 0.2s; font-weight: 700; text-decoration: none; flex-shrink: 0; }
    .wa-tab:hover { background: rgba(255,255,255,0.06); color: var(--text); }
    .wa-tab.active { background: var(--primary); color: white; }
    @media (max-width: 768px) {
      .wa-tab { padding: 6px 10px; font-size: 12px; }
      .form-row, .grid-2 { grid-template-columns: 1fr !important; }
    }
  </style>
</head>
<body>
<%- include('partials/sidebar', { activePage: activePage || 'broadcast', company }) %>
<div class="mw">
  <div class="topbar">
    <div class="tb-title"><button class="hb-menu" onclick="toggleSidebar()"><i class="bi bi-list"></i></button><i class="bi bi-megaphone"></i> <%= t('admin.broadcast.title', 'Broadcast WhatsApp') %></div>
    <div class="tb-right">
      <span class="adm-badge"><i class="bi bi-person-fill"></i> <%= (typeof session !== 'undefined' && session.isCashier) ? t('admin.role.cashier', 'Kasir') : t('admin.role.admin', 'Admin') %></span>
      <a href="/admin/logout" class="btn btn-g btn-sm"><i class="bi bi-box-arrow-left"></i></a>
    </div>
  </div>
  <div class="page">
    <% const waTab = 'broadcast'; %>

    <% if (msg) { %>
    <div class="alert alert-<%= msg.type==='success'?'s':'d' %>">
      <i class="bi bi-<%= msg.type==='success'?'check-circle':'exclamation-circle' %>"></i> <%= msg.text %>
    </div>
    <% } %>

    <div class="wa-tabs">
      <a href="/admin/whatsapp" class="wa-tab <%= waTab==='status' ? 'active' : '' %>"><i class="bi bi-phone"></i> Status</a>
      <a href="/admin/whatsapp/broadcast" class="wa-tab <%= waTab==='broadcast' ? 'active' : '' %>"><i class="bi bi-megaphone"></i> Broadcast & Pengingat</a>
      <a href="/admin/whatsapp/templates" class="wa-tab <%= waTab==='templates' ? 'active' : '' %>"><i class="bi bi-chat-left-quote"></i> Template Pesan</a>
    </div>

    <div class="card">
      <div class="card-hd" style="display: flex; justify-content: space-between; align-items: center;">
        <h6><i class="bi bi-send-fill"></i> <%= t('admin.broadcast.send_mass', 'Kirim Pesan Massal') %></h6>
        <div id="broadcastCounter" class="badge bp" style="display: none;">
          <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
          <%= t('admin.broadcast.sending', 'Mengirim:') %> <span id="sentCount">0</span>/<span id="totalCount">0</span>
          (<span id="failedCount" class="text-danger ms-1">0</span> <%= t('admin.broadcast.failed', 'Gagal') %>)
        </div>
      </div>
      <form id="broadcastForm" method="POST" action="/admin/whatsapp/broadcast" data-confirm="<%= t('admin.broadcast.confirm_send', 'Kirim pesan broadcast sekarang? Pastikan target dan pesan sudah benar.') %>">
        <div class="card-bd">
          <div class="alert alert-i" style="margin-bottom: 14px; background: rgba(99,102,241,0.12); border: 1px solid rgba(99,102,241,0.3);">
            <div style="font-weight: 800; margin-bottom: 4px; display: flex; align-items: center; gap: 6px; color: var(--primary);">
              <i class="bi bi-shield-check" style="font-size: 16px;"></i> Protection Anti-Banned Active (Human Typing Simulation & Spintax)
            </div>
            <div style="font-size: 12px; line-height: 1.5; color: var(--text);">
              • <strong>Simulasi Mengetik Manusia:</strong> Sistem mengirim sinyal <code>sedang mengetik...</code> di WhatsApp penerima sebelum pesan dikirim.<br>
              • <strong>Variasi Kata Spintax:</strong> Gunakan <code>{Halo|Selamat Pagi|Yth.}</code> agar isi pesan otomatis diacak & tidak dianggap spam.<br>
              • <strong>Jeda Acak & Batching:</strong> Dikirim dengan jeda acak dinamis dan jeda istirahat otomatis antar batch.
            </div>
          </div>



          <div class="form-row" style="margin-bottom: 15px;">
            <div class="fg">
              <label class="fl"><%= t('admin.broadcast.target', 'Target Penerima') %></label>
              <select class="fs" name="target" id="targetSelect" required style="width: 100%;">
                <option value="all"><%= t('admin.broadcast.target_all', 'Semua Pelanggan (Aktif & Isolir)') %></option>
                <option value="active"><%= t('admin.broadcast.target_active', 'Hanya Pelanggan Aktif') %></option>
                <option value="suspended"><%= t('admin.broadcast.target_suspended', 'Hanya Pelanggan Terisolir') %></option>
                <option value="unpaid"><%= t('admin.broadcast.target_unpaid', 'Pelanggan yang Punya Tunggakan Tagihan') %></option>
              </select>
            </div>
            <div class="fg">
              <label class="fl"><%= t('admin.broadcast.delay', 'Jeda Antar Pesan (Detik)') %></label>
              <input class="fc" type="number" name="delay" value="<%= getSetting('whatsapp_broadcast_delay', 2) %>" min="1" max="60">
            </div>
          </div>

          <div class="alert alert-d alert-permanent" style="margin-bottom: 20px; border: 1px solid rgba(248,81,73,0.4);">
            <i class="bi bi-exclamation-triangle-fill"></i> <strong><%= t('admin.broadcast.warning_title', 'PERINGATAN PENTING:') %></strong> <%= t('admin.broadcast.warning_body', 'Penggunaan fitur broadcast massal berisiko menyebabkan akun WhatsApp Anda DIBLOKIR (BANNED) oleh pihak Meta jika dianggap melanggar ketentuan spam. Pastikan pesan relevan bagi pelanggan. Developer aplikasi tidak bertanggung jawab atas segala risiko pemblokiran akun.') %>
          </div>
          
          <div class="form-row">
            <div class="fg" style="width: 100%;">
              <label class="fl"><%= t('admin.broadcast.message', 'Isi Pesan WhatsApp') %></label>
              <textarea class="fc" name="message" id="messageBox" rows="8" required style="width: 100%;"></textarea>
              <div style="font-size: 11px; color: var(--muted); margin-top: 6px;">
                <i class="bi bi-info-circle"></i> <%= t('admin.broadcast.variables', 'Variabel:') %> <b>{{nama}}</b>, <b>{{tagihan}}</b>, <b>{{rincian}}</b>, <b>{{paket}}</b>, <b>{{link}}</b> (<%= t('admin.broadcast.portal_link', 'Link Portal') %>).
                <br>
                <i class="bi bi-chat-text"></i> <%= t('admin.broadcast.formatting', 'Gunakan *Tebal*, _Miring_, atau ~Coret~ sesuai standar WhatsApp.') %>
              </div>
            </div>
          </div>
        </div>
        <div class="card-bd" style="border-top: 1px solid var(--border); background: var(--bg2); display: flex; justify-content: flex-end;">
          <button type="submit" class="btn btn-p"><i class="bi bi-send"></i> <%= t('admin.broadcast.start', 'Mulai Broadcast') %></button>
        </div>
      </form>
    </div>

    <div class="card">
      <div class="card-hd">
        <h6><i class="bi bi-alarm"></i> Pengingat Tagihan Otomatis</h6>
      </div>
      <form method="POST" action="/admin/whatsapp/auto-billing" onsubmit="return confirm('Simpan pengaturan pengingat tagihan otomatis?');">
        <div class="card-bd">
          <%
            // autoBillingMsg is loaded dynamically from the SQLite database
          %>
          <div class="form-row" style="margin-bottom: 12px;">
            <div class="fg" style="width: 100%;">
              <label class="fl">Kirim Tagihan via WhatsApp (Global)</label>
              <label style="display:flex; align-items:center; gap:10px; font-weight:800; color: var(--text);">
                <input type="checkbox" name="billing_enabled" value="1" <%= getSetting('whatsapp_billing_to_customer_enabled', true) ? 'checked' : '' %>>
                Izinkan kirim tagihan ke pelanggan
              </label>
              <div style="font-size: 11px; color: var(--muted); margin-top: 6px;">
                Mengatur izin pengiriman tagihan WhatsApp untuk semua fitur (manual & otomatis).
              </div>
            </div>
          </div>

          <div class="form-row" style="margin-bottom: 12px;">
            <div class="fg" style="width: 100%;">
              <label class="fl">Pengingat Otomatis (Jadwal)</label>
              <label style="display:flex; align-items:center; gap:10px; font-weight:800; color: var(--text);">
                <input type="checkbox" name="enabled" value="1" <%= getSetting('whatsapp_auto_billing_enabled', false) ? 'checked' : '' %>>
                Jalankan pengingat tagihan otomatis (CRON)
              </label>
              <div style="font-size: 11px; color: var(--muted); margin-top: 6px;">
                Sistem mengirim pengingat ke pelanggan yang punya tunggakan, pada hari-hari yang dicentang di bawah sebelum tanggal isolir (isolate_day).
              </div>

              <div style="margin-top:12px;padding:12px;border:1px solid var(--border);border-radius:10px;background:var(--bg3)">
                <div style="font-size:11px;font-weight:700;color:var(--muted);margin-bottom:8px">JADWAL PENGINGAT</div>
                <% const hariIngat = (function(){ const v = getSetting('whatsapp_reminder_days', [1]); return Array.isArray(v) ? v.map(Number) : String(v||'').split(',').map(Number); })(); %>
                <div style="display:flex;gap:16px;flex-wrap:wrap;align-items:center">
                  <label style="display:flex;align-items:center;gap:8px;cursor:pointer">
                    <input type="checkbox" name="remind_h7" value="1" <%= hariIngat.includes(7) ? 'checked' : '' %>> H-7
                  </label>
                  <label style="display:flex;align-items:center;gap:8px;cursor:pointer">
                    <input type="checkbox" name="remind_h5" value="1" <%= hariIngat.includes(5) ? 'checked' : '' %>> H-5
                  </label>
                  <label style="display:flex;align-items:center;gap:8px;cursor:pointer">
                    <input type="checkbox" name="remind_h3" value="1" <%= hariIngat.includes(3) ? 'checked' : '' %>> H-3
                  </label>
                  <label style="display:flex;align-items:center;gap:8px;opacity:.7">
                    <input type="checkbox" checked disabled> H-1 <span style="font-size:11px">(selalu dikirim)</span>
                  </label>
                </div>
                <div style="font-size:11px;color:var(--muted);margin-top:8px">
                  Contoh: pelanggan dengan tanggal isolir 10 dan H-7 aktif akan diingatkan pada tanggal 3, lalu 5, 7, dan 9 sesuai centang.
                </div>
              </div>
            </div>
          </div>

          <div class="form-row" style="margin-bottom: 12px;">
            <div class="fg">
              <label class="fl">Jeda Acak &mdash; minimal (detik)</label>
              <input class="fc" type="number" name="delay_min" value="<%= getSetting('whatsapp_delay_min', 45) || 45 %>" min="5" max="600">
            </div>
            <div class="fg">
              <label class="fl">maksimal (detik)</label>
              <input class="fc" type="number" name="delay_max" value="<%= getSetting('whatsapp_delay_max', 100) || 100 %>" min="5" max="600">
            </div>
          </div>
          <div style="font-size: 11px; color: var(--muted); margin: -6px 0 12px;">
            Jeda tiap pesan diundi acak dalam rentang ini, jadi polanya tidak seragam dan tidak mudah terbaca sebagai bot.
            Jangan terlalu kecil &mdash; 45&ndash;100 detik adalah rentang yang aman.
          </div>

          <div class="form-row" style="margin-bottom: 12px;">
            <div class="fg">
              <label class="fl">Jeda Broadcast Manual (Detik)</label>
              <input class="fc" type="number" name="delay" value="<%= getSetting('whatsapp_broadcast_delay', 2) %>" min="1" max="60">
              <div style="font-size: 11px; color: var(--muted); margin-top: 6px;">
                Hanya dipakai sebagai nilai bawaan pada broadcast manual di atas.
              </div>
            </div>
          </div>

          <div class="form-row">
            <div class="fg" style="width: 100%;">
              <label class="fl">Isi Pesan WhatsApp</label>
              <textarea class="fc" name="message" rows="8" required style="width: 100%;"><%= autoBillingMsg %></textarea>
              <div style="font-size: 11px; color: var(--muted); margin-top: 6px;">
                <i class="bi bi-info-circle"></i> Variabel: <b>{{nama}}</b>, <b>{{tagihan}}</b>, <b>{{rincian}}</b>, <b>{{paket}}</b>, <b>{{link}}</b> (link login otomatis), <b>{{h-}}</b> &rarr; otomatis jadi <i>(7 Hari Sebelum)</i>, <i>(5 Hari Sebelum)</i>, dst. sesuai jadwal yang sedang berjalan.
                <br><b>{{harganoqris}}</b> &rarr; nominal tanpa kode unik QRIS (<i>150.000</i>), sedangkan <b>{{tagihan}}</b> memuat kode unik (<i>150.247</i>).
              </div>
            </div>
          </div>
        </div>
        <div class="card-bd" style="border-top: 1px solid var(--border); background: var(--bg2); display: flex; justify-content: flex-end;">
          <button type="submit" class="btn btn-p"><i class="bi bi-save"></i> Simpan</button>
        </div>
      </form>
    </div>

    <!-- Panel uji coba pesan pengingat -->
    <div class="card" style="margin-top: 20px;">
      <div class="card-hd"><h6><i class="bi bi-send-check"></i> Uji Coba Pesan Pengingat</h6></div>
      <div class="card-bd">
        <div style="font-size:12px;color:var(--muted);margin-bottom:12px">
          Kirim satu pesan ke nomor Anda sendiri memakai template di atas, untuk memastikan formatnya sudah benar.
          Data tagihan pada pesan uji hanya contoh &mdash; tidak mengambil data pelanggan mana pun.
        </div>
        <div class="form-row">
          <div class="fg">
            <label class="fl">Nomor WhatsApp Tujuan</label>
            <input class="fc" id="tr_phone" placeholder="6281234567890 atau 081234567890">
          </div>
          <div class="fg">
            <label class="fl">Kirim sebagai</label>
            <select class="fs" id="tr_h">
              <option value="7">H-7 &rarr; (7 Hari Sebelum)</option>
              <option value="5">H-5 &rarr; (5 Hari Sebelum)</option>
              <option value="3">H-3 &rarr; (3 Hari Sebelum)</option>
              <option value="1" selected>H-1 &rarr; (1 Hari Sebelum)</option>
            </select>
          </div>
        </div>
        <div class="form-row">
          <div class="fg" style="width:100%">
            <label class="fl">Nama pada pesan uji</label>
            <input class="fc" id="tr_nama" value="Pelanggan Uji">
          </div>
        </div>
        <pre id="tr_preview" style="display:none;white-space:pre-wrap;background:var(--bg3);border:1px solid var(--border);border-radius:10px;padding:12px;font-size:12px;margin-top:10px"></pre>
        <div id="tr_info" style="font-size:12px;margin-top:10px"></div>
      </div>
      <div class="card-bd" style="border-top:1px solid var(--border);background:var(--bg2);display:flex;justify-content:flex-end;gap:8px">
        <button type="button" class="btn btn-g" onclick="ujiPengingat(true)"><i class="bi bi-eye"></i> Pratinjau Saja</button>
        <button type="button" class="btn btn-p" onclick="ujiPengingat(false)"><i class="bi bi-whatsapp"></i> Kirim Pesan Uji</button>
      </div>
    </div>

    <!-- Kirim pengingat manual ke pelanggan sungguhan -->
    <div class="card" style="margin-top: 20px;">
      <div class="card-hd"><h6><i class="bi bi-send-fill"></i> Kirim Pengingat Sekarang (Manual)</h6></div>
      <div class="card-bd">
        <div style="font-size:12px;color:var(--muted);margin-bottom:12px">
          Cadangan kalau jadwal otomatis jam 07:00 terlewat &mdash; server mati, WhatsApp belum tersambung,
          atau tagihan baru dibuat siang hari. Pelanggan dipilih dari tanggal isolir dikurangi H- yang dicentang,
          dan hanya yang punya tunggakan. Pesannya sama persis dengan pengingat otomatis.
        </div>
        <div style="font-size:11px;color:var(--warning);margin-bottom:12px">
          <i class="bi bi-exclamation-triangle"></i> Ini mengirim WhatsApp ke pelanggan sungguhan.
          Setelah antrean manual jalan, pengingat otomatis hari ini tidak akan mengirim ulang.
        </div>

        <label class="fl">Kirim untuk H- berapa saja</label>
        <div style="display:flex;gap:16px;flex-wrap:wrap;align-items:center;margin-bottom:12px">
          <label style="display:flex;align-items:center;gap:8px;cursor:pointer">
            <input type="checkbox" class="km-h" value="7" checked> H-7
          </label>
          <label style="display:flex;align-items:center;gap:8px;cursor:pointer">
            <input type="checkbox" class="km-h" value="5" checked> H-5
          </label>
          <label style="display:flex;align-items:center;gap:8px;cursor:pointer">
            <input type="checkbox" class="km-h" value="3" checked> H-3
          </label>
          <label style="display:flex;align-items:center;gap:8px;cursor:pointer">
            <input type="checkbox" class="km-h" value="1" checked> H-1
          </label>
        </div>

        <div id="km_info" style="font-size:12px"></div>
        <div id="km_progress" style="display:none;margin-top:10px;padding:10px;border:1px solid var(--border);border-radius:10px;background:var(--bg3);font-size:12px"></div>
      </div>
      <div class="card-bd" style="border-top:1px solid var(--border);background:var(--bg2);display:flex;justify-content:flex-end;gap:8px">
        <button type="button" class="btn btn-g" onclick="lihatTargetPengingat()"><i class="bi bi-people"></i> Lihat Target</button>
        <button type="button" class="btn btn-p" onclick="kirimPengingatSekarang()"><i class="bi bi-send"></i> Kirim Sekarang</button>
      </div>
    </div>

  </div>
</div>

<script>
// ── Kirim pengingat manual ke pelanggan sungguhan ──────────────────────────
function hMinusTerpilih() {
  return Array.from(document.querySelectorAll('.km-h:checked')).map(function (el) { return Number(el.value); });
}

function ringkasRincian(rincian) {
  const bagian = Object.keys(rincian || {}).sort().map(function (k) { return k + ': ' + rincian[k]; });
  return bagian.length ? bagian.join(', ') : 'tidak ada';
}

async function lihatTargetPengingat() {
  const info = document.getElementById('km_info');
  info.textContent = 'Menghitung...';
  try {
    const res = await fetch('/admin/api/whatsapp/send-reminder-now', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      body: JSON.stringify({ h_list: hMinusTerpilih(), preview: true })
    });
    const data = await res.json();
    if (!data.ok) throw new Error(data.error);
    info.innerHTML = data.total
      ? '<span style="color:var(--success)">' + data.total + ' pelanggan akan dikirimi pengingat.</span> <span style="color:var(--muted)">(' + ringkasRincian(data.rincian) + ')</span>'
      : '<span style="color:var(--warning)">Tidak ada pelanggan yang cocok. Pastikan tagihan sudah di-generate dan tanggal isolirnya sesuai.</span>';
  } catch (e) {
    info.innerHTML = '<span style="color:var(--danger)">Gagal: ' + e.message + '</span>';
  }
}

async function kirimPengingatSekarang() {
  const info = document.getElementById('km_info');
  const hari = hMinusTerpilih();
  if (!hari.length) { info.innerHTML = '<span style="color:var(--danger)">Centang minimal satu H-.</span>'; return; }

  info.textContent = 'Menghitung target...';
  let jumlah = 0;
  try {
    const cek = await fetch('/admin/api/whatsapp/send-reminder-now', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      body: JSON.stringify({ h_list: hari, preview: true })
    });
    const hasil = await cek.json();
    if (!hasil.ok) throw new Error(hasil.error);
    jumlah = hasil.total;
  } catch (e) {
    info.innerHTML = '<span style="color:var(--danger)">Gagal: ' + e.message + '</span>';
    return;
  }

  if (!jumlah) {
    info.innerHTML = '<span style="color:var(--warning)">Tidak ada pelanggan yang cocok, tidak ada yang dikirim.</span>';
    return;
  }
  if (!confirm('Kirim pengingat WhatsApp ke ' + jumlah + ' pelanggan sungguhan (H-' + hari.join(', H-') + ')?\n\nPengiriman berjeda acak, jadi butuh waktu lama untuk selesai.')) return;

  try {
    const res = await fetch('/admin/api/whatsapp/send-reminder-now', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      body: JSON.stringify({ h_list: hari, preview: false })
    });
    const data = await res.json();
    if (!data.ok) throw new Error(data.error);
    info.innerHTML = '<span style="color:var(--success)">Antrean dimulai untuk ' + data.total + ' pelanggan.</span>';
    pantauAntrean();
  } catch (e) {
    info.innerHTML = '<span style="color:var(--danger)">Gagal: ' + e.message + '</span>';
  }
}

let timerAntrean = null;
async function pantauAntrean() {
  const box = document.getElementById('km_progress');
  box.style.display = 'block';
  const tarik = async function () {
    try {
      const res = await fetch('/admin/api/whatsapp/reminder-status', { headers: { 'Accept': 'application/json' } });
      const data = await res.json();
      const st = (data && data.status) || {};
      const persen = st.total ? Math.round((st.terkirim / st.total) * 100) : 0;
      box.innerHTML =
        '<b>' + (st.berjalan ? 'Sedang mengirim' : 'Antrean selesai') + '</b> &mdash; ' +
        (st.terkirim || 0) + '/' + (st.total || 0) + ' (' + persen + '%)' +
        (st.gagal ? ', gagal ' + st.gagal : '') +
        (st.sumber ? '<br><span style="color:var(--muted)">sumber: ' + st.sumber + ', mulai ' + (st.mulai || '-') + '</span>' : '');
      if (!st.berjalan && timerAntrean) { clearInterval(timerAntrean); timerAntrean = null; }
    } catch (e) { /* diamkan, coba lagi di tarikan berikutnya */ }
  };
  await tarik();
  if (timerAntrean) clearInterval(timerAntrean);
  timerAntrean = setInterval(tarik, 10000);
}

// Uji coba pesan pengingat. preview=true hanya menampilkan hasil, tidak mengirim.
async function ujiPengingat(preview) {
  const info = document.getElementById('tr_info');
  const pre = document.getElementById('tr_preview');
  const phone = document.getElementById('tr_phone').value.trim();

  if (!preview) {
    if (!phone) { info.innerHTML = '<span style="color:var(--danger)">Nomor tujuan belum diisi.</span>'; return; }
    if (!confirm('Kirim pesan uji ke ' + phone + ' sekarang?')) return;
  }

  info.textContent = preview ? 'Menyusun pratinjau...' : 'Mengirim...';
  try {
    const res = await fetch('/admin/api/whatsapp/test-reminder', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      body: JSON.stringify({
        phone: phone || '628000000000',
        h_minus: document.getElementById('tr_h').value,
        nama: document.getElementById('tr_nama').value,
        preview_only: !!preview
      })
    });
    const data = await res.json();
    if (!data.ok) throw new Error(data.error);

    pre.style.display = 'block';
    pre.textContent = data.message;
    info.innerHTML = preview
      ? '<span style="color:var(--muted)">Pratinjau saja - tidak ada pesan yang dikirim.</span>'
      : '<span style="color:var(--success)">Terkirim ke ' + data.phone + '.</span>';
  } catch (e) {
    info.innerHTML = '<span style="color:var(--danger)">Gagal: ' + e.message + '</span>';
  }
}

const I18N = {
  confirmChangeTarget: "<%= t('admin.broadcast.confirm_change_target', 'Ganti target penerima? Pesan yang sudah Anda ketik akan ditimpa dengan template baru.') %>",
  sendingText: "<%= t('admin.broadcast.sending_btn', 'Sedang Mengirim...') %>",
  donePrefix: "<%= t('admin.broadcast.done_prefix', 'Selesai:') %>",
  sentSuffix: "<%= t('admin.broadcast.sent_suffix', 'dikirim') %>",
  startBtn: "<%= t('admin.broadcast.start', 'Mulai Broadcast') %>"
};
const templates = {
  all: `Yth. Pelanggan {{nama}},\n\nBersama ini kami informasikan bahwa akan ada pemeliharaan jaringan rutin pada:\nHari/Tanggal: ...\nPukul: ...\n\nSelama proses tersebut, layanan internet (Paket {{paket}}) akan terganggu sementara waktu. Kami memohon maaf atas ketidaknyamanan ini.\n\nCek status layanan di: {{link}}\n\nTerima kasih.\nSalam,\nAdmin <%= company %>`,
  
  active: `Yth. Pelanggan Setia {{nama}},\n\nTerima kasih telah mempercayakan kebutuhan internet Anda kepada kami. Nikmati terus layanan terbaik Paket {{paket}} tanpa hambatan.\n\nKelola akun Anda di: {{link}}\n\nSalam,\nAdmin <%= company %>`,
  
  suspended: `Yth. Pelanggan {{nama}},\n\nMohon maaf, layanan internet Anda saat ini sedang dinonaktifkan (Terisolir). \n\nTotal tunggakan Anda: *Rp {{tagihan}}* (Periode: {{rincian}}).\n\nSilakan bayar melalui portal kami: {{link}}\n\nSalam,\nAdmin <%= company %>`,
  
  unpaid: `Yth. Pelanggan {{nama}},\n\nBerdasarkan data sistem kami, Anda memiliki tagihan internet yang *BELUM LUNAS*.\n\n📦 *Paket:* {{paket}}\n💰 *Total Tagihan:* Rp {{tagihan}}\n📅 *Periode:* {{rincian}}\n\nMohon segera melakukan pembayaran melalui portal pelanggan: {{link}}\n\nTerima kasih atas kerja samanya.\nSalam,\nAdmin <%= company %>`
};

const targetSelect = document.getElementById('targetSelect');
const messageBox = document.getElementById('messageBox');

// Set template awal
messageBox.value = templates[targetSelect.value];

// Ganti template saat dropdown berubah
targetSelect.addEventListener('change', function() {
  if (confirm(I18N.confirmChangeTarget)) {
    messageBox.value = templates[this.value];
  } else {
    // Revert dropdown if canceled
    for(let i=0; i<this.options.length; i++) {
      if(templates[this.options[i].value] === messageBox.value) {
        this.selectedIndex = i;
        break;
      }
    }
  }
});

setTimeout(()=>document.querySelectorAll('.alert:not(.alert-permanent)').forEach(a=>a.style.display='none'),5000);

// Polling Broadcast Status
const broadcastCounter = document.getElementById('broadcastCounter');
const sentCountEl = document.getElementById('sentCount');
const totalCountEl = document.getElementById('totalCount');
const failedCountEl = document.getElementById('failedCount');
const submitBtn = document.querySelector('button[type="submit"]');
const broadcastForm = document.getElementById('broadcastForm');

if (broadcastForm) {
  broadcastForm.addEventListener('submit', function (e) {
    const msg = String(broadcastForm.dataset.confirm || '').trim();
    if (msg && !confirm(msg)) e.preventDefault();
  });
}

async function checkBroadcastStatus() {
  try {
    const res = await fetch('/admin/api/whatsapp/broadcast-status');
    const status = await res.json();
    
    if (status.active) {
      broadcastCounter.style.display = 'inline-flex';
      sentCountEl.textContent = status.sent;
      totalCountEl.textContent = status.total;
      failedCountEl.textContent = status.failed;
      submitBtn.disabled = true;
      submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span> ' + I18N.sendingText;
    } else {
      if (status.total > 0 && status.sent + status.failed === status.total) {
        // Just finished
        broadcastCounter.className = 'badge bs';
        broadcastCounter.innerHTML = `<i class="bi bi-check-circle-fill me-1"></i> ${I18N.donePrefix} ${status.sent}/${status.total} ${I18N.sentSuffix}`;
        submitBtn.disabled = false;
        submitBtn.innerHTML = '<i class="bi bi-send"></i> ' + I18N.startBtn;
      } else {
        broadcastCounter.style.display = 'none';
      }
    }
  } catch (e) { console.error('Status check failed', e); }
}

// Start polling
setInterval(checkBroadcastStatus, 2000);
checkBroadcastStatus();
</script>
</body>
</html>
