<!DOCTYPE html>
<html lang="<%= lang || 'id' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#071c49">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <title>Masuk Pelanggan | <%= settings.company_header || 'Elround Network' %></title>
  <link rel="manifest" href="/manifest.webmanifest">
  <link rel="icon" href="/img/logo.png">
  <link rel="apple-touch-icon" href="/img/logo.png">
  <style>
    :root { font-family: Arial, Helvetica, sans-serif; color: #0a1d45; background: #f7faff; font-synthesis: none; }
    *, *::before, *::after { box-sizing: border-box; }
    body { min-width: 320px; min-height: 100vh; min-height: 100svh; margin: 0; }
    button, input { font: inherit; }
    :focus-visible { outline: 3px solid #3da4ff; outline-offset: 3px; }
    .page { display: flex; flex-direction: column; min-height: 100vh; min-height: 100svh; }
    .header { display: flex; align-items: center; justify-content: space-between; gap: 24px; width: min(100% - 48px, 1120px); margin: 0 auto; padding: 24px 0; }
    .brand { display: inline-flex; align-items: center; }
    .brand img { display: block; width: 190px; height: auto; }
    .home-link { color: #075dcc; font-size: 14px; font-weight: 700; text-decoration: none; }
    .home-link:hover { text-decoration: underline; }
    main { display: grid; place-items: center; flex: 1; padding: 16px 24px 32px; }
    .login-card { width: min(100%, 470px); padding: clamp(28px, 5vw, 48px); border: 1px solid #d7e5f6; border-radius: 18px; background: #fff; box-shadow: 0 18px 50px rgba(7, 28, 73, .07); }
    h1 { margin: 0; font-size: clamp(29px, 5vw, 36px); line-height: 1.12; letter-spacing: -.04em; }
    .intro { margin: 12px 0 32px; color: #415272; font-size: 15px; line-height: 1.6; }
    .field { margin-top: 20px; }
    .field label { display: block; margin-bottom: 9px; font-size: 14px; font-weight: 700; }
    .field input { display: block; width: 100%; height: 52px; padding: 0 15px; border: 1px solid #b9cee9; border-radius: 9px; background: #fff; color: #0a1d45; outline: none; }
    .field input::placeholder { color: #74839e; }
    .field input:focus { border-color: #126df4; box-shadow: 0 0 0 3px rgba(18, 109, 244, .14); }
    .password-wrap { position: relative; }
    .password-wrap input { padding-right: 88px; }
    .password-visibility { position: absolute; top: 5px; right: 5px; min-width: 76px; height: 42px; border: 0; border-radius: 6px; background: transparent; color: #075dcc; font-size: 13px; font-weight: 700; cursor: pointer; }
    .password-visibility:hover { background: #eaf4ff; }
    .options { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin: 20px 0 28px; font-size: 13px; }
    .remember { display: inline-flex; align-items: center; gap: 8px; cursor: pointer; }
    .remember input { width: 16px; height: 16px; margin: 0; accent-color: #126df4; }
    .options a { color: #075dcc; font-weight: 700; text-decoration: none; }
    .options a:hover { text-decoration: underline; }
    .notice { margin: 0 0 20px; padding: 12px 14px; border-radius: 8px; font-size: 13px; line-height: 1.45; }
    .notice-error { border: 1px solid #f0b8b6; background: #fff1f0; color: #8b2420; }
    .notice-otp { background: #eaf4ff; color: #0b4ea1; }
    .submit { width: 100%; min-height: 52px; border: 0; border-radius: 9px; background: #126df4; color: #fff; font-weight: 700; cursor: pointer; }
    .submit:hover { background: #095bcf; }
    .submit:active { background: #064da9; }
    @media (max-width: 520px) {
      .header { width: calc(100% - 40px); padding: 20px 0; }
      .brand img { width: 150px; }
      .home-link { max-width: 92px; text-align: right; line-height: 1.3; }
      main { align-items: start; padding: 24px 20px 48px; }
      .login-card { padding: 28px 24px; }
    }
  </style>
</head>
<body>
  <div class="page">
    <header class="header">
      <a class="brand" href="/" aria-label="Elround Network, kembali ke beranda">
        <img src="/logo-landscape.webp" width="224" height="71" alt="Elround Network">
      </a>
      <a class="home-link" href="/">Kembali ke beranda</a>
    </header>
    <main>
      <section class="login-card" aria-labelledby="login-title">
        <h1 id="login-title">Masuk sebagai pelanggan</h1>
        <p class="intro">Gunakan nomor WhatsApp yang terdaftar dan kata sandi akun Anda.</p>
        <% if (error) { %>
          <p class="notice notice-error" role="alert"><%= error %></p>
        <% } %>
        <form method="POST" action="/customer/signin">
          <div class="field">
            <label for="phone">Nomor WhatsApp</label>
            <input type="tel" id="phone" name="phone" inputmode="tel" autocomplete="username" placeholder="08xxxxxxxxxx" required autofocus>
          </div>
          <div class="field">
            <label for="password">Kata sandi</label>
            <div class="password-wrap">
              <input type="password" id="password" name="password" autocomplete="current-password" required>
              <button type="button" id="password-visibility" class="password-visibility" aria-label="Tampilkan kata sandi" aria-pressed="false">Tampilkan</button>
            </div>
          </div>
          <div class="options">
            <label class="remember" for="remember-phone"><input type="checkbox" id="remember-phone"> Ingat nomor saya</label>
            <a href="<%= settings.company_phone ? 'https://wa.me/' + String(settings.company_phone).replace(/\D/g, '').replace(/^0/, '62') + '?text=' + encodeURIComponent('Halo, saya lupa kata sandi portal pelanggan.') : '/customer/contact' %>"<% if (settings.company_phone) { %> target="_blank" rel="noopener"<% } %>>Lupa kata sandi?</a>
          </div>
          <% if (settings.login_otp_enabled) { %>
            <p class="notice notice-otp"><%= t('customer.otp_sent_via_wa', 'Kode OTP akan dikirim via WhatsApp') %></p>
          <% } %>
          <button class="submit" type="submit"><%= t('customer.sign_in', 'Masuk') %></button>
        </form>
      </section>
    </main>
  </div>
  <script>
    const portalForm = document.querySelector('form[action="/customer/signin"]');
    const phoneInput = document.getElementById('phone');
    const rememberPhone = document.getElementById('remember-phone');
    const passwordInput = document.getElementById('password');
    const passwordVisibility = document.getElementById('password-visibility');
    try {
      const savedPhone = localStorage.getItem('elround_remember_phone');
      if (savedPhone) {
        phoneInput.value = savedPhone;
        rememberPhone.checked = true;
      }
    } catch (_) {}
    portalForm.addEventListener('submit', () => {
      try {
        if (rememberPhone.checked) {
          localStorage.setItem('elround_remember_phone', phoneInput.value.trim());
        } else {
          localStorage.removeItem('elround_remember_phone');
        }
      } catch (_) {}
    });
    passwordVisibility.addEventListener('click', () => {
      const visible = passwordInput.type === 'text';
      passwordInput.type = visible ? 'password' : 'text';
      passwordVisibility.textContent = visible ? 'Tampilkan' : 'Sembunyikan';
      passwordVisibility.setAttribute('aria-pressed', String(!visible));
      passwordVisibility.setAttribute('aria-label', visible ? 'Tampilkan kata sandi' : 'Sembunyikan kata sandi');
    });
    if ('serviceWorker' in navigator) {
      window.addEventListener('load', () => {
        navigator.serviceWorker.register('/sw.js', { scope: '/customer/' }).catch(() => {});
      });
    }
  </script>
</body>
</html>
