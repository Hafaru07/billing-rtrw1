<!doctype html>
<html lang="id">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex">
  <% const code = Number(statusCode) || 500; %>
  <title><%= code %> | Elround Network</title>
  <link rel="icon" href="/img/logo.png">
  <style>
    :root { color-scheme: light; font-family: Arial, Helvetica, sans-serif; }
    * { box-sizing: border-box; }
    body { margin: 0; min-height: 100vh; background: #0e1f49; color: #fff; }
    .site-header { background: #fff; }
    .header-inner { max-width: 1180px; margin: auto; min-height: 88px; padding: 16px 32px; display: flex; align-items: center; }
    .brand { display: inline-flex; align-items: center; }
    .brand img { display: block; width: 194px; max-width: 100%; height: auto; }
    main { position: relative; display: flex; align-items: center; min-height: calc(100vh - 88px); overflow: hidden; isolation: isolate; }
    main::before { content: ""; position: absolute; inset: 0; z-index: -1; background: radial-gradient(circle at 78% 48%, #27569c 0, #1a3b73 20%, transparent 48%); }
    .content { width: min(1180px, 100%); margin: auto; padding: 80px 32px 104px; display: grid; grid-template-columns: minmax(0, 1fr) minmax(300px, .85fr); align-items: center; gap: 48px; }
    .eyebrow { margin: 0 0 24px; color: #7eb7ff; font-size: 14px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; }
    h1 { max-width: 680px; margin: 0; font-size: clamp(48px, 6.2vw, 82px); line-height: 1.04; letter-spacing: -.055em; }
    .description { max-width: 480px; margin: 28px 0 0; color: #d4e1f5; font-size: clamp(17px, 1.8vw, 20px); line-height: 1.6; }
    .actions { display: flex; align-items: center; flex-wrap: wrap; gap: 14px 22px; margin-top: 36px; }
    .button { display: inline-flex; align-items: center; justify-content: center; min-height: 52px; padding: 12px 25px; border-radius: 999px; background: #fff; color: #0e1f49; font-weight: 700; text-decoration: none; transition: background .18s, transform .18s; }
    .button:hover { background: #dcecff; transform: translateY(-2px); }
    .text-link { display: inline-flex; align-items: center; min-height: 52px; color: #fff; font-weight: 700; text-decoration: none; }
    .text-link:hover { text-decoration: underline; text-underline-offset: 4px; }
    a:focus-visible { outline: 3px solid #68adff; outline-offset: 4px; }
    .art { position: relative; display: grid; place-items: center; aspect-ratio: 1; }
    .art::before, .art::after { content: ""; position: absolute; border: 28px solid #3475c9; border-radius: 50%; }
    .art::before { width: 91%; height: 91%; transform: translate(18%, 8%); opacity: .9; }
    .art::after { width: 56%; height: 56%; border-color: #1f4b8b; transform: translate(-20%, -10%); }
    .art-number { position: relative; z-index: 1; font-size: clamp(130px, 19vw, 260px); line-height: 1; font-weight: 800; letter-spacing: -.1em; text-shadow: 0 18px 40px #05133166; }
    @media (max-width: 760px) {
      .header-inner { min-height: 72px; padding-inline: 22px; }
      .brand img { width: 165px; }
      main { min-height: calc(100vh - 72px); }
      .content { grid-template-columns: 1fr; gap: 8px; padding: 76px 24px 58px; }
      h1 { max-width: 600px; }
      .art { width: min(340px, 88vw); justify-self: end; margin: 16px -12px -90px 0; opacity: .75; }
      .art-number { font-size: clamp(135px, 31vw, 195px); }
    }
    @media (prefers-reduced-motion: reduce) { .button { transition: none; } }
  </style>
</head>
<body>
  <header class="site-header">
    <div class="header-inner">
      <a class="brand" href="/" aria-label="Elround Network, ke beranda">
        <img src="/landing/logo-landscape.webp" alt="Elround Network">
      </a>
    </div>
  </header>
  <main>
    <div class="content">
      <div>
        <p class="eyebrow">Kesalahan <%= code %></p>
        <h1><%= code === 404 ? 'Halaman ini tidak ditemukan.' : 'Halaman sedang bermasalah.' %></h1>
        <p class="description"><%= code === 404 ? 'Alamatnya mungkin salah ketik atau halaman sudah dipindahkan. Coba kembali ke beranda.' : 'Coba buka kembali beberapa saat lagi. Jika masalah berlanjut, hubungi tim kami.' %></p>
        <div class="actions">
          <a class="button" href="/">Ke beranda</a>
          <a class="text-link" href="/customer/signin">Masuk pelanggan →</a>
        </div>
      </div>
      <div class="art" aria-hidden="true"><span class="art-number"><%= code %></span></div>
    </div>
  </main>
</body>
</html>
